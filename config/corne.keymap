#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Firmware sends QWERTY keycodes; macOS translates them through the
// "Colemak DH-Viet" layout. Comments show the character that comes out.
// Command shortcuts follow the DH-Viet letters, so Cmd+C is the physical V
// key, Cmd+V is X, Cmd+Z is B and Cmd+X is P.

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "BASE";
			// | TAB  |  q  |  w  |  f  |  g  |  b  |   |  ;  |  l  |  u  |  y  |  x  | ESC  |
			// | CTRL |  a  |  h  |  s  |  t  |  p  |   |  m  |  n  |  e  |  o  |  i  | ALT  |
			// | SHFT |  j  |  v  |  r  |  c  |  z  |   |  k  |  d  |  ,  |  .  |  /  | SHFT |
			//                    | GUI | NAV | SPC |   | BSPC| ENT | SYM |
			bindings = <
&kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U &kp I     &kp O   &kp P    &kp ESC
&kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J &kp K     &kp L   &kp SEMI &kp RALT
&kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                  &kp LGUI &mo 1 &kp SPACE   &kp BSPC &kp RET &mo 2
			>;
		};

		nav_layer {
			display-name = "NAV";
			// |      | ESC  | PGUP |  UP  | PGDN | REDO |   | BTCLR| BRI- | BRI+ | BT1  | BT2  | BT3  |
			// |      | HOME | LEFT | DOWN | RGHT | END  |   | BT4  | GUI  | ALT  | CTRL | SHFT |      |
			// |      | DEL  | PSTE | CUT  | COPY | UNDO |   | BT5  | MUTE | VOL- | VOL+ | PLAY |      |
			//                      |      |      |      |   | DELW |      |      |
			bindings = <
&trans &kp ESC      &kp PG_UP &kp UP    &kp PG_DN &kp LG(LS(B))    &bt BT_CLR   &kp C_BRI_DN &kp C_BRI_UP &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2
&trans &kp LG(LEFT) &kp LEFT  &kp DOWN  &kp RIGHT &kp LG(RIGHT)    &bt BT_SEL 3 &kp LGUI     &kp LALT     &kp LCTRL    &kp LSHFT &trans
&trans &kp DEL      &kp LG(X) &kp LG(P) &kp LG(V) &kp LG(B)        &bt BT_SEL 4 &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &kp C_PP  &trans
                              &trans    &trans    &trans           &kp LA(BSPC) &trans &trans
			>;
		};

		sym_layer {
			display-name = "SYM";
			// |  `  |  [  |  7  |  8  |  9  |  ]  |   | F1  | F2  | F3  | F4  | F5  | F6  |
			// |  '  |  -  |  4  |  5  |  6  |  =  |   |     | GUI | ALT | CTRL| SHFT|     |
			// |  \  |  .  |  1  |  2  |  3  |  ,  |   | F7  | F8  | F9  | F10 | F11 | F12 |
			//                   |     |  0  |     |   |     |     |     |
			bindings = <
&kp GRAVE &kp LBKT  &kp N7 &kp N8 &kp N9 &kp RBKT     &kp F1 &kp F2   &kp F3   &kp F4    &kp F5    &kp F6
&kp SQT   &kp MINUS &kp N4 &kp N5 &kp N6 &kp EQUAL    &trans &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &trans
&kp BSLH  &kp DOT   &kp N1 &kp N2 &kp N3 &kp COMMA    &kp F7 &kp F8   &kp F9   &kp F10   &kp F11   &kp F12
                           &trans &kp N0 &trans       &trans &trans   &trans
			>;
		};
	};
};
