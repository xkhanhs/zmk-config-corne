#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// 36 keys: the two outer columns are unassigned. Firmware sends QWERTY
// keycodes and macOS must be on a QWERTY input source (VTX Telex mode), so
// the comments show the character that comes out. No hold-tap anywhere:
// every key has one function and layer keys are hold-only.

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "BASE";
			// |     |  q  |  w  |  e  |  r  |  t  |   |  y  |  u  |  i  |  o  |  p  |     |
			// |     |  a  |  s  |  d  |  f  |  g  |   |  h  |  j  |  k  |  l  |  ;  |     |
			// |     |  z  |  x  |  c  |  v  |  b  |   |  n  |  m  |  ,  |  .  |  /  |     |
			//                   | GUI | NAV | SPC |   | BSPC| SHFT| ENT |
			bindings = <
&none &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U &kp I     &kp O   &kp P    &none
&none &kp A &kp S &kp D &kp F &kp G   &kp H &kp J &kp K     &kp L   &kp SEMI &none
&none &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M &kp COMMA &kp DOT &kp FSLH &none
              &kp LGUI &mo 1 &kp SPACE   &kp BSPC &kp LSHFT &kp RET
			>;
		};

		nav_layer {
			display-name = "NAV";
			// Left hand moves, right hand is a numpad. WRDL/WRDR jump a word
			// (Alt+arrow), DELW deletes a word (Alt+Backspace), FN is held on
			// top of NAV to reach the third layer.
			// |     | ESC  |  [   |  UP  |  ]   |  `   |   |  +   |  7   |  8   |  9   |  '   |     |
			// |     | GUI  | LEFT | DOWN | RGHT | TAB  |   |  -   |  4   |  5   |  6   |  0   |     |
			// |     | SHFT | WRDL |  \   | WRDR | C-c  |   |  =   |  1   |  2   |  3   |  .   |     |
			//                      |      |      |      |   | DELW |      |  FN  |
			bindings = <
&none &kp ESC   &kp LBKT     &kp UP   &kp RBKT      &kp GRAVE    &kp PLUS  &kp N7 &kp N8 &kp N9 &kp SQT &none
&none &kp LGUI  &kp LEFT     &kp DOWN &kp RIGHT     &kp TAB      &kp MINUS &kp N4 &kp N5 &kp N6 &kp N0  &none
&none &kp LSHFT &kp LA(LEFT) &kp BSLH &kp LA(RIGHT) &kp LC(C)    &kp EQUAL &kp N1 &kp N2 &kp N3 &kp DOT &none
                             &trans   &trans        &trans       &kp LA(BSPC) &trans &mo 2
			>;
		};

		fn_layer {
			display-name = "FN";
			// SHOT2..SHOT5 are the macOS screenshot shortcuts Cmd+Shift+2..5.
			// |     | BT1  | BT2  | BT3  | BT4  | BT5  |   | BTCLR| BRI- | BRI+ |      |      |     |
			// |     |      |      |      |      |      |   |      | MUTE | VOL- | VOL+ | PLAY |     |
			// |     |      | SHOT2| SHOT3| SHOT4| SHOT5|   |      |      |      |      |      |     |
			//                      |      |      |      |   |      |      |      |
			bindings = <
&none &bt BT_SEL 0 &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4      &bt BT_CLR &kp C_BRI_DN &kp C_BRI_UP &none        &none    &none
&none &none        &none          &none          &none          &none             &none      &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &kp C_PP &none
&none &none        &kp LG(LS(N2)) &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LG(LS(N5))    &none      &none        &none        &none        &none    &none
                                  &trans         &trans         &trans            &trans     &trans       &trans
			>;
		};
	};
};
